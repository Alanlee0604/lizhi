# Required on Vercel for POST /api/probe. Do not commit the real value.
PROBE_TOKEN=

# Optional. Also accepted as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Required to POST readings to votes ingest. Parent bot sets this on the Vercel project.
INGEST_TOKEN=

# Optional override. Default is https://votes.alan0828.cloud/api/ingest
INGEST_URL=

# Optional override. Default is https://votes.alan0828.cloud/api/state (read-only shared source).
STATE_URL=

# Optional local Chrome path for non-Vercel runs.
CHROME_PATH=/usr/bin/google-chrome-stable
